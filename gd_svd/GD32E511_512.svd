                  <bitOffset>0</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>write-only</access>
                </field>
            </fields>
          </register>
          <register>
            <name>IBIPLDATA</name>
            <displayName>IBIPLDATA</displayName>
