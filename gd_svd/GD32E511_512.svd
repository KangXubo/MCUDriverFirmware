              </field>
          </fields>
        </register>
        <register>
          <name>ADDR1</name>
          <displayName>ADDR1</displayName>
          <description>Address register1</description>
          <addressOffset>0x54</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>ADDR</name>
                <description>Flash command address bits</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>write-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>EFSWD</name>
          <displayName>EFSWD</displayName>
          <description>Efuse SWD protection register</description>
          <addressOffset>0x58</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>EF_SWD_VALUE</name>
                <description>This field load EF_SWD_VALUE from e-flash when system reset. This field can be written by software.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EF_SWD_BIT</name>
                <description>Read only, when EF_SWD_VALUE is 0x33CC, set 1. Otherwise set 0</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>EF_SWD_START</name>
                <description>This bit triggers an operation after writing EF_SWD_VALUE to e-flash. It is set only by software and cleared when the BUSY bit is cleared</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EF_SWD_LK</name>
                <description>Read only'when EF_SWD_VALUE if not 0xFFFF, set EF_SWD_LK 1. When EF_SWD_LK is 1, this register can`t be configured anymore.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>EFBOOT</name>
          <displayName>EFBOOT</displayName>
          <description>Efuse BOOT protection register</description>
          <addressOffset>0x5C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>EF_BOOT_VALUE</name>
                <description>This field load EF_BOOT_VALUE from e-flash when system reset. This field can be written by software.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EF_BOOT_BIT</name>
                <description>Read only, when EF_BOOT_VALUE is 0x33CC, set 1. Otherwise set 0</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>EF_BOOT_START</name>
                <description>This bit triggers an operation after writing EF_BOOT_VALUE to e-flash. It is set only by software and cleared when the BUSY bit is cleared</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EF_BOOT_LK</name>
                <description>Read only'when EF_BOOT_VALUE if not 0xFFFF, set EF_BOOT_LK 1. When EF_BOOT_LK is 1, this register can`t be configured anymore.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>PID</name>
          <displayName>PID</displayName>
          <description>Product ID register</description>
          <addressOffset>0x100</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>PID</name>
                <description>Product reserved ID code register</description>
                <bitOffset>0</bitOffset>
                <bitWidth>32</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>ECCERR</name>
          <displayName>ECCERR</displayName>
          <description>ECC error register</description>
          <addressOffset>0x120</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>ECCADDR</name>
                <description>The offset address of four word where an ECC error is detected.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>SECCERRIE</name>
                <description>Single bit error correct interrupt enable.</description>
                <bitOffset>15</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DECCERRIE</name>
                <description>Double bit errors detect interrupt enable.</description>
                <bitOffset>14</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>BANK_ECCERR</name>
                <description>This bit is used to indicate which bank of the flash has generated an ECC error.</description>
                <bitOffset>7</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>BANK1_ECCERR</name>
                <description>If an ECC bit error is detected in Bank1 flash, this bit will be set. And the ECCADDR records the offset address of main Flash. DECCERR bit and SECCERR bit indicate there is a single bit error or a double bit error. This bit is cleared by writing 1.</description>
                <bitOffset>6</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>OB_ECCERR</name>
                <description>If an ECC bit error is detected in reading option bytes, this bit will be set. And the ECCADDR records the offset address of option bytes. DECCERR bit and SECCERR bit indicate there is a single bit error or a double bit error. This bit is cleared by writing 1.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>OTP_ECCERR</name>
                <description>If an ECC bit error is detected in OTP, this bit will be set. And the ECCADDR records the offset address of OTP. DECCERR bit and SECCERR bit indicate there is a single bit error or a double bit error. This bit is cleared by writing 1.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>BANK0_ECCERR</name>
                <description>If an ECC bit error is detected in Bank0 Flash, this bit will be set. And the ECCADDR records the offset address of main Flash. SECCERR bit and DECCERR bit indicate there is a single bit error or a double bit error. This bit is cleared by writing 1.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SYS_ECCERR</name>
                <description>If an ECC bit error is detected in system memory, this bit will be set. And the ECCADDR records the offset address of system memory. SECCERR bit and DECCERR bit indicate there is a single bit error or a double bit error. This bit is cleared by writing 1.</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DECCERR</name>
                <description>Double bit errors detect flag. This bit set when two bit errors is detected.</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SECCERR</name>
                <description>Single bit error detected and correct flag.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
          </fields>
        </register>
      </registers>
    </peripheral>
