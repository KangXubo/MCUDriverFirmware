                  <bitOffset>8</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>IBIPDATA0</name>
                  <description>8-bit IBI payload data (earliest byte on I3C bus, MDB[7:0] mandatory data byte). Data byte to go with an IBI, if enabled for it. If enabled (BCR2 bit is set), then it is required.</description>
                  <bitOffset>0</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>read-write</access>
                </field>
            </fields>
