            <addressOffset>0x020</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                  <name>IBIPDATA3</name>
                  <description>8-bit IBI payload data</description>
                  <bitOffset>24</bitOffset>
                  <bitWidth>8</bitWidth>
                  <access>read-write</access>
                </field>
                <field>
                  <name>IBIPDATA2</name>
                  <description>8-bit IBI payload data</description>
