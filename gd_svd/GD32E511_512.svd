    <peripheral>
      <name>MDIO</name>
      <description>Management data input/output</description>
      <baseAddress>0x4000D800</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>MDIO</name>       
        <value>40</value>
      </interrupt>
      <registers>
        <register>
          <name>CTL</name>
          <displayName>CTL</displayName>
          <description>Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>RDOD</name>
                <description>receive data overrun disable</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PHYB</name>
                <description>MDIO PHY bit length</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>SWRST</name>
                <description>Write 1 to reset MDIO block. Reisters will not be reset. Hardware immediately clears this bit.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>write-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>RFRM</name>
          <displayName>RFRM</displayName>
          <description>Received frame register</description>
          <addressOffset>0x04</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>RTA</name>
                <description>Received frame field TA (only accept TA bits of a write data frame or a write address frame)</description>
                <bitOffset>12</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>RDEV</name>
                <description>Received frame field DEVADD</description>
                <bitOffset>7</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>RPHY</name>
                <description>Received frame field PHYADR</description>
                <bitOffset>2</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>ROP</name>
                <description>Received frame field OP</description>
                <bitOffset>0</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>RDATA</name>
          <displayName>RDATA</displayName>
          <description>Received data register</description>
          <addressOffset>0x08</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>RDATA</name>
                <description>Received frame field DATA</description>
                <bitOffset>0</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>RADDR</name>
          <displayName>RADDR</displayName>
          <description>Received address register</description>
          <addressOffset>0x0C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>RADDR</name>
                <description>Received frame field ADDRESS</description>
                <bitOffset>0</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>TDATA</name>
          <displayName>TDATA</displayName>
          <description>Transfer data register</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>TDATA</name>
                <description>Data that is transmitted by the next read or post read increment address frame. Before a read data frame, the master sends a write address frame to specify which data is to be read. After this write address frame, the user software must place this requested data into MDIO_TDATA before it is required by the read frame. The time available is at latest 3 MDIO clock cycles before TA.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-write</access>
              </field>
          </fields>
        </register>
        <register>
          <name>CFG</name>
          <displayName>CFG</displayName>
          <description>Configuration register</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>EDEVADD</name>
                <description>Expected DEVADD. Normally 01.</description>
                <bitOffset>10</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>EPHYSEL</name>
                <description>Selects expected PHYADR. For each x bit of the 5 bits:</description>
                <bitOffset>5</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PHYSW</name>
                <description>Software provided PHYADR. Chosen according to corresponding EPHYSEL[4:0] bits</description>
                <bitOffset>0</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-write</access>
              </field>
          </fields>
        </register>
        <register>
          <name>STAT</name>
          <displayName>STAT</displayName>
          <description>Status register</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x00001000</resetValue>
          <fields>
              <field>
                <name>RBNE</name>
                <description>Read data buffer not empty flag. Data is received and ready to be read. Cleared by reading the MDIO_RDATA register.</description>
                <bitOffset>13</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>OVR</name>
                <description>Receive overrun flag. Set by hardware when the data in the receive shift register is ready to be transferred into the MDIO_RDATA register while the RBNE bit is set. Cleared by reading the MDIO_RDATA register.</description>
                <bitOffset>11</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>UDR</name>
                <description>Transmit underrun flag. Set by hardware if the data has not been written to MDIO_TDATA register 3 MDIO clock cycles before TA of a read / post read increment address frame when the MDIO_TDATA is empty. Cleared by a write to the MDIO_TDATA register.</description>
                <bitOffset>10</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>TO</name>
                <description>Timeout flag. If a new bit of a frame is not received or a bit of the prepared data is not transmitted before reaching the configured timeout value, this bit will be set by hardware. Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>9</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>TANM</name>
                <description>When the received TA is not 10 for a write data / address frame, this bit will be set at end bit of TA. Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>8</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYNM</name>
                <description>When the received PHYADR does not match, this bit will be set at end bit of PHYADR. Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>7</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>PHYM</name>
                <description>When the received PHYADR matches, this bit will be set at end bit of PHYADR. Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>6</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>DEVNM</name>
                <description>When the received DEVADD does not match, this bit will be set at end bit of DEVADD. Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>DEVM</name>
                <description>When the received DEVADD matches, this bit will be set at end bit of DEVADD. Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>RDFRM</name>
                <description>When the received DEVADD and PHYADR both match for a read data frame, this bit will be set at end bit (after frame field DATA transmission). Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>RDINCFRM</name>
                <description>When the received DEVADD and PHYADR both match for a post read increment address frame, this bit will be set at end bit (after frame field DATA transmission). Cleared by reading MDIO_STAT register.</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>ADDRFRM</name>
                <description>When the received DEVADD and PHYADR both match for a write address frame, this bit will be set at end bit (after frame field DATA transmission). Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
              <field>
                <name>WRFRM</name>
                <description>When the received DEVADD and PHYADR both match for a write data frame, this bit will be set at end bit (after frame field DATA transmission). Cleared by reading the MDIO_STAT register.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>INTEN</name>
          <displayName>INTEN</displayName>
          <description>Interrupt enable register</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>RBNEIE</name>
                <description>An interrupt is generated when this bit and RBNE bit in MDIO_STAT register are both set.</description>
                <bitOffset>13</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>OVRIE</name>
                <description>An interrupt is generated when this bit and OVR bit in MDIO_STAT register are both set.</description>
                <bitOffset>11</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>UDRIE</name>
                <description>An interrupt is generated when this bit and UDR bit in MDIO_STAT register are both set.</description>
                <bitOffset>10</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>TOIE</name>
                <description>An interrupt is generated when this bit and TO bit in MDIO_STAT register are both set.</description>
                <bitOffset>9</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>TANMIE</name>
                <description>An interrupt is generated when this bit and TANM bit in MDIO_STAT register are both set.</description>
                <bitOffset>8</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PHYNMIE</name>
                <description>An interrupt is generated when this bit and PHYNM bit in MDIO_STAT register are both set.</description>
                <bitOffset>7</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>PHYMIE</name>
                <description>An interrupt is generated when this bit and PHYM bit in MDIO_STAT register are both set.</description>
                <bitOffset>6</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DEVNMIE</name>
                <description>An interrupt is generated when this bit and DEVNM bit in MDIO_STAT register are both set.</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>DEVMIE</name>
                <description>An interrupt is generated when this bit and DEVM bit in MDIO_STAT register are both set.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>RDFRMIE</name>
                <description>An interrupt is generated when this bit and RDFRM bit in MDIO_STAT register are both set.</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>RDINCFRMIE</name>
                <description>An interrupt is generated when this bit and RDINCFRM bit in MDIO_STAT register are both set.</description>
                <bitOffset>2</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>ADDRFRMIE</name>
                <description>An interrupt is generated when this bit and ADDRFRM bit in MDIO_STAT register are both set.</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>WRFRMIE</name>
                <description>An interrupt is generated when this bit and WRFRM bit in MDIO_STAT register are both set.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
          </fields>
        </register>
        <register>
          <name>PIN</name>
          <displayName>PIN</displayName>
          <description>Pin value register</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>PHYPIN</name>
                <description>Pin value read from hardware MDIO_Ax pins</description>
                <bitOffset>0</bitOffset>
                <bitWidth>5</bitWidth>
                <access>read-only</access>
              </field>
          </fields>
        </register>
        <register>
          <name>TO</name>
          <displayName>TO</displayName>
          <description>Timeout register</description>
          <addressOffset>0x24</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
              <field>
                <name>TOCNT</name>
                <description>MDIO time out = TOCNT[15:0]*PCLK</description>
                <bitOffset>1</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-write</access>
              </field>
              <field>
                <name>TOEN</name>
                <description>Timeout enable</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
              </field>
          </fields>
        </register>
      </registers>
    </peripheral>

