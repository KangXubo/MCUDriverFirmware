    <peripheral>
      <name>CAU</name>
      <description>Cryptographic Acceleration Unit</description>
      <groupName>CAU</groupName>
      <baseAddress>0x40023400</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
