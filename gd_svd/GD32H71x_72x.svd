<peripheral>
    <name>ESC_CORE</name>
    <description>EtherCAT core</description>
    <groupName>ESC</groupName>
    <baseAddress>0x5F00D300</baseAddress>
    <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
    </addressBlock>
    <registers>
        <register>
            <name>CCTL_DATA</name>
            <displayName>CCTL_DATA</displayName>
            <description>ESC CCTL data register</description>
            <addressOffset>0x00</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>CCTL_DATA</name>
                    <description>ESC CCTL data</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>32</bitWidth>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>CCTL_CMD</name>
            <displayName>CCTL_CMD</displayName>
            <description>ESC CCTL command register</description>
            <addressOffset>0x04</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>CCTL_BUSY</name>
                    <description>CCTL Busy. There is no effect if the bit is written to 0</description>
                    <bitOffset>31</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>CCTL_RW</name>
                    <description>Read or write selection</description>
                    <bitOffset>30</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>CCTL_STOP</name>
                    <description>Stop read or write operation. There is no effect if the bit is written to 0.</description>
                    <bitOffset>29</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>CCTL_SIZE</name>
                    <description>This field specifies the size of the register that is about to be read or write. (in byte). Only 1, 2 and 4 are valid, other values are invalid.</description>
                    <bitOffset>16</bitOffset>
                    <bitWidth>3</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>CCTL_ADDR</name>
                    <description>This field specifies the address of ESC registers that will be accessed.</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>16</bitWidth>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>PRAM_FIFO_DR</name>
            <displayName>PRAM_FIFO_DR</displayName>
            <description>ESC PRAM FIFO data read register</description>
            <addressOffset>0x10</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>PRAM_FIFO_DATA_READ</name>
                    <description>Data read from ESC PRAM.</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>32</bitWidth>
                    <access>read-only</access>
                </field>
            </fields>
        </register>
        <register>
            <name>PRAM_ALR</name>
            <displayName>PRAM_ALR</displayName>
            <description>ESC PRAM address and length read register</description>
            <addressOffset>0x14</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>PRAM_LEN_READ</name>
                    <description>Data length read from ESC PRAM in bytes. This field is decremented as data is read into the FIFO.</description>
                    <bitOffset>16</bitOffset>
                    <bitWidth>16</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PRAM_ADDR_READ</name>
                    <description>ESC PRAM data read address. This field is incremented as data is read into the FIFO.</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>16</bitWidth>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>PRAM_CR</name>
            <displayName>PRAM_CR</displayName>
            <description>ESC PRAM command read register</description>
            <addressOffset>0x18</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>PRAM_BUSY_READ</name>
                    <description>Whether the PRAM is being read. There is no effect if the bit is written to 0</description>
                    <bitOffset>31</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PRAM_STOP_READ</name>
                    <description>Stop PRAM read operation. There is no effect if the bit is written to zero</description>
                    <bitOffset>30</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PRAM_DATA_CNT_READ</name>
                    <description>PRAM data read valid count</description>
                    <bitOffset>8</bitOffset>
                    <bitWidth>5</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>PRAM_VALID_DATA_READ</name>
                    <description>PRAM valid data read</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
            </fields>
        </register>
        <register>
            <name>PRAM_FIFO_DW</name>
            <displayName>PRAM_FIFO_DW</displayName>
            <description>ESC PRAM FIFO data write register</description>
            <addressOffset>0x20</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>PRAM_FIFO_DATA_WRITE</name>
                    <description>Data write to ESC PRAM.</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>32</bitWidth>
                    <access>write-only</access>
                </field>
            </fields>
        </register>
        <register>
            <name>PRAM_ALW</name>
            <displayName>PRAM_ALW</displayName>
            <description>ESC PRAM address and length write register</description>
            <addressOffset>0x24</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000000</resetValue>
            <fields>
                <field>
                    <name>PRAM_LEN_WRITE</name>
                    <description>Data length written to ESC PRAM in bytes. This field is decremented as data is written into the FIFO.</description>
                    <bitOffset>16</bitOffset>
                    <bitWidth>16</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PRAM_ADDR_WRITE</name>
                    <description>ESC PRAM data write address. This field is incremented as data is read from the FIFO.</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>16</bitWidth>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>PRAM_CW</name>
            <displayName>PRAM_CW</displayName>
            <description>ESC PRAM command write register</description>
            <addressOffset>0x28</addressOffset>
            <size>0x20</size>
            <resetValue>0x00001001</resetValue>
            <fields>
                <field>
                    <name>PRAM_BUSY_WRITE</name>
                    <description>Whether the PRAM is being written. There is no effect if the bit is written to zero</description>
                    <bitOffset>31</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PRAM_STOP_WRITE</name>
                    <description>Stop PRAM write operation. There is no effect if the bit is written to zero</description>
                    <bitOffset>30</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>PRAM_VALID_CNT_WRITE</name>
                    <description>PRAM data write valid count</description>
                    <bitOffset>8</bitOffset>
                    <bitWidth>5</bitWidth>
                    <access>read-only</access>
                </field>
                <field>
                    <name>PRAM_VALID_DATA_WRITE</name>
                    <description>PRAM valid data write</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-only</access>
                </field>
            </fields>
        </register>
        <register>
            <name>CTL</name>
            <displayName>CTL</displayName>
            <description>ESC Control register</description>
            <addressOffset>0x30</addressOffset>
            <size>0x20</size>
            <resetValue>0x000004A0</resetValue>
            <fields>
                <field>
                    <name>WDLF</name>
                    <description>Write data lost flag</description>
                    <bitOffset>29</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WDLIE</name>
                    <description>Write data lost interrupt enable</description>
                    <bitOffset>28</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>TOF</name>
                    <description>Time out flag, when single transmission time exceeds the programmed value, this flag will be triggered. This flag can be cleared by writing 1.</description>
                    <bitOffset>27</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>TOIE</name>
                    <description>Timer out interrupt enable</description>
                    <bitOffset>26</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WEF</name>
                    <description>write error flag. when BRP disable, AHB write operation will cause current OPB transmission error when the busy bit is high, this flag will be triggered. This flag can be cleared by writing 1.</description>
                    <bitOffset>25</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>WEIE</name>
                    <description>Write error interrupt enable.</description>
                    <bitOffset>24</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>CCTLIVF</name>
                    <description>CCTL_SIZE and CCTL_ADDR illegal value flag</description>
                    <bitOffset>23</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>CCTLIVIE</name>
                    <description>CCTL_SIZE and CCTL_ADDR Illegal value interrupt enable.</description>
                    <bitOffset>22</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>I2CF</name>
                    <description>Internal I2C communication error flag.</description>
                    <bitOffset>21</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>I2CIE</name>
                    <description>Internal I2C overrun interrupt enable.</description>
                    <bitOffset>20</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>EEPROM_CF</name>
                    <description>The flag signal indicating the completion of EEPROM reloading by ESC</description>
                    <bitOffset>19</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>EEPROM_CFIE</name>
                    <description>EEPROM_CF interrupt flag enable</description>
                    <bitOffset>18</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>EEPROM_SF</name>
                    <description>The flag indicating the start of EEPROM reloading by ESC</description>
                    <bitOffset>17</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>EEPROM_SFIE</name>
                    <description>EEPROM_SF interrupt flag enable</description>
                    <bitOffset>16</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>ESC_IRQF</name>
                    <description>The flag IRQ signal generated by ESC is used to trigger a MCU interrupt</description>
                    <bitOffset>15</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>ESC_SYNC0F</name>
                    <description>The flag SYNC0 signal generated by ESC is used to trigger a MCU interrupt</description>
                    <bitOffset>14</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>ESC_SYNC1F</name>
                    <description>The flag SYNC1 signal generated by ESC is used to trigger a MCU interrupt SYNC1 event</description>
                    <bitOffset>13</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>BRP</name>
                    <description>When busy bit is high, prevent register change</description>
                    <bitOffset>10</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>TO_CNT</name>
                    <description>Time Out counter</description>
                    <bitOffset>1</bitOffset>
                    <bitWidth>9</bitWidth>
                    <access>read-write</access>
                </field>
                <field>
                    <name>TOEN</name>
                    <description>Time Out enable</description>
                    <bitOffset>0</bitOffset>
                    <bitWidth>1</bitWidth>
                    <access>read-write</access>
                </field>
            </fields>
        </register>
        <register>
            <name>CFG</name>
            <displayName>CFG</displayName>
            <description>ESC Config register</description>
            <addressOffset>0x34</addressOffset>
            <size>0x20</size>
            <resetValue>0x00000020</resetValue>
