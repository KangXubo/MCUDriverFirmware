          <description>Clock-to-data turnaround time (tSCO)</description>
          <bitOffset>24</bitOffset>
          <bitWidth>1</bitWidth>
          <access>read-write</access>
        </field>
        <field>
          <name>RDTURN</name>
          <description>Programmed byte of the 3-byte MaxRdTurn</description>
          <bitOffset>16</bitOffset>
          <bitWidth>8</bitWidth>
          <access>read-write</access>
        </field>
        <field>
          <name>FMAT</name>
          <description>GETMXDS CCC format</description>
          <bitOffset>8</bitOffset>
          <bitWidth>2</bitWidth>
          <access>read-write</access>
        </field>
      </fields>
    </register>
    <register>
      <name>EXTPID</name>
      <displayName>EXTPID</displayName>
      <description>Extended provisioned ID register</description>
      <addressOffset>0x0D4</addressOffset>
      <size>0x20</size>
      <resetValue>0x09BE0000</resetValue>
      <fields>
        <field>
          <name>MIPIMFRID</name>
