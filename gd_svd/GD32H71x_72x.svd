          <bitOffset>23</bitOffset>
          <bitWidth>1</bitWidth>
          <access>write-only</access>
        </field>
        <field>
          <name>GETFC</name>
          <description>Set this bit to clear GETF flag in I3C_STAT register</description>
          <bitOffset>22</bitOffset>
          <bitWidth>1</bitWidth>
          <access>write-only</access>
        </field>
        <field>
