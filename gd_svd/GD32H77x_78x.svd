        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI4</name>
        <value>85</value>
      </interrupt>
      <registers>
        <register>
          <name>SPI_CTL0</name>
