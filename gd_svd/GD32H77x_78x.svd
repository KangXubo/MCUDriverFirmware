              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>OBBBADDR1_MDF</name>
        <displayName>OBBBADDR1_MDF</displayName>
        <description>Option byte bad block address register 1</description>
        <addressOffset>0xbC</addressOffset>
        <size>0x20</size>
        <resetValue>0x08000000</resetValue>
        <fields>
            <field>
              <name>OBBBADDR</name>
              <description>Bad block address configure bit</description>
              <bitOffset>5</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OBBBADDRVLD</name>
              <description>The bad block address recorded by the option byte valid configure bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>OBBBADDR2_MDF</name>
        <displayName>OBBBADDR2_MDF</displayName>
        <description>Option byte bad block address register 2</description>
        <addressOffset>0xC0</addressOffset>
        <size>0x20</size>
        <resetValue>0x08000000</resetValue>
        <fields>
            <field>
              <name>OBBBADDR</name>
              <description>Bad block address configure bit</description>
              <bitOffset>5</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OBBBADDRVLD</name>
              <description>The bad block address recorded by the option byte valid configure bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>OBBBADDR3_MDF</name>
        <displayName>OBBBADDR3_MDF</displayName>
        <description>Option byte bad block address register 3</description>
        <addressOffset>0xC4</addressOffset>
        <size>0x20</size>
        <resetValue>0x08000000</resetValue>
        <fields>
            <field>
              <name>OBBBADDR</name>
              <description>Bad block address configure bit</description>
              <bitOffset>5</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OBBBADDRVLD</name>
              <description>The bad block address recorded by the option byte valid configure bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLANKADDR</name>
          <displayName>BLANKADDR</displayName>
          <description>Blank address register</description>
          <description>Option byte bad block address register 2</description>
          <addressOffset>0xfc</addressOffset>
          <resetValue>0x08000000</resetValue>
          <fields>
            <field>
              <name>BLANKADDR</name>
              <description>Flash backup blank corresponding address. The address is in eNVM address area, the granularity is 256bit. This bit field records only the last address that appears.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>PID0</name>
        <displayName>PID0</displayName>
        <description>Product ID register 0</description>
        <addressOffset>0x100</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>PID</name>
              <description>Product reserved ID code register x</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
        </fields>
      </register>
      <register>
        <name>PID1</name>
        <displayName>PID1</displayName>
        <description>Product ID register 1</description>
        <addressOffset>0x104</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>PID</name>
              <description>Product reserved ID code register x</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
        </fields>
      </register>
      <register>
        <name>NMIERRADDR</name>
        <displayName>NMIERRADDR</displayName>
        <description>Not maskable interrupt error address register</description>
        <addressOffset>0x108</addressOffset>
        <size>0x20</size>
        <resetValue>0x08000000</resetValue>
        <fields>
            <field>
              <name>NMIERRADDR</name>
              <description>AXI read with uncorrectable error interrupt (including case of failure to repair with 3-bit error). The address is in eNVM address area, the granularity is 256bit.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>CS</name>
        <displayName>CS</displayName>
        <description>NVMC control and status register</description>
        <addressOffset>0x330</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>EEBBUSY</name>
              <description>Empty eNVM buffer busy bit</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
        </fields>
      </register>
      <register>
        <name>ENVM_KEY</name>
        <displayName>ENVM_KEY</displayName>
        <description>ENVM unlock key register</description>
        <addressOffset>0x004</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>KEY</name>
              <description>NVMC_ENVM_CTL unlock register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
        </fields>
      </register>
      <register>
        <name>ENVM_CTL</name>
        <displayName>ENVM_CTL</displayName>
        <description>ENVM control register</description>
        <addressOffset>0x00C</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000001</resetValue>
        <fields>
            <field>
              <name>REPRESC</name>
              <description>Clear the result of the self-repair function, including the counter, error address, and status. (Including ROBBCNT, ERR2CNT, ERR1CNT, FLBLANK bit in NVMC_ENVM_REPCS register, NVMC_ENVM_ROBBADDRx, NVMC_ENVM_UNREPECCADDRx). The repair function refers to the self-check repair function after the reset.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>AUTOREPRESC</name>
              <description>Clear the result of the automatic repair function, including the counter, error address, and status. (Including AUTOECCSERRDET, AUTOECCDERRDET bit in NVMC_ENVM_STAT register, NMIERRINT, FLBLANK, ECC1CNTIF, ECC2CNTIF, REPERRSTAT bit in NVMC_ENVM_REPCS register, NVMC_ENVM_AUTOERR1ADDRx, NVMC_ENVM_AUTOERR2ADDRx, NVMC_NMIERRADDR). The automatic repair function refers to the automatic repair function in the process of bus reading eNVM.</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CRCRERRIE</name>
              <description>ENVM CRC read error interrupt enable</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCENDCALIE</name>
              <description>ENVM CRC end of calculation interrupt enable</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTOECCDERRDETIE</name>
              <description>ENVM ECC two bit errors detect interrupt enable.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTOECCSERRDETIE</name>
              <description>ENVM ECC one bit error detect interrupt enable.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RSERRIE</name>
              <description>Read secure error interrupt enable.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RPERRIE</name>
              <description>Read protection error interrupt enable</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OTAFAILCNT</name>
              <description>OTA fail times count, this bit resets upon power-on reset, but is unaffected by system reset.</description>
              <bitOffset>19</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PGSERRIE</name>
              <description>Program sequence error interrupt enable</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WPERRIE</name>
              <description>Erase / program protection error interrupt enable</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENDIE</name>
              <description>End of operation interrupt enable</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCSTART</name>
              <description>CRC check is enabled to check the eNVM content between the NVMC_OBREPSTADDR_MDF and the NVMC_OBREPENDADDR_MDF. When the end or error occurs, this bit is cleared by hardware.</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENVM_ECC_LK</name>
              <description>ENVM_ECC_LK, which can only write 1. After writing 1, ENVM_ECC_MODE cannot be overwritten. The ENVM_ECC_MODE is used to test related functions. After the test is complete, users are advised to enable and lock the ENVM_ECC_LK function.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENVM_ECC_MODE</name>
              <description>ENVM ECC mode configuration bit</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>START</name>
              <description>Send erase command to NVMC</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CER</name>
              <description>Chip erase command bit</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MER</name>
              <description>ENVM mass erase command bit (Not for case4)</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SER</name>
              <description>ENVM sector erase command bit</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PG</name>
              <description>ENVM program command bit</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LK</name>
              <description>NVMC_ENVM_CTL lock bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>ENVM_STAT</name>
        <displayName>ENVM_STAT</displayName>
        <description>ENVM status register</description>
        <addressOffset>0x010</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>ENVMECCF</name>
              <description>ENVM ECC function flag.</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BOOT_AT_CHECK_SYS_EFT</name>
              <description>Flag generated by the option byte EFT, indicating boot from the check_bootLoader (Not for case4)</description>
              <bitOffset>30</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BOOT_AT_CHECK_SYS_MDF</name>
              <description>Flag generated by the option byte MDF, indicating boot from the check_bootLoader. This bit contains only the FW_UPDATE and software self-check settings. (Not for case4)</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>CRCRERR</name>
              <description>CRC read error flag</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCENDCAL</name>
              <description>CRC end of calculation flag</description>
              <bitOffset>27</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AUTOECCDERRDET</name>
              <description>Two bit errors detect flag bit.</description>
              <bitOffset>26</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>AUTOECCSERRDET</name>
              <description>One bit error detect flag bit.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RSERR</name>
              <description>Read secure error flag bit.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RPERR</name>
              <description>Read protection error flag bit.</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>COPYSTRERR</name>
              <description>Copy startup failure error flag bit.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLENDF</name>
              <description>End of flash operation flag bit. (Not for case4)</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OTASUC</name>
              <description>OTA upgrade, check_bootloader check success flag. (Not for case4)</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>OTAFAIL</name>
              <description>OTA upgrade, check_bootloader check failure flag. (Not for case4)</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PGSERR</name>
              <description>Program sequence error flag bit.</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WPERR</name>
              <description>Erase / program protection error flag bit.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENDF</name>
              <description>End of operation flag bit.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NVMVER</name>
              <description>Nvm version</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>SW_REP_FLBLANK</name>
              <description>Software self-check repair flash backup content blank flag (Not for case4)</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SW_REP_FATAL</name>
              <description>Software self-check repair fatal error flag (Not for case4)</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SW_REP_ERR</name>
              <description>Software self-check repair error flag (Not for case4)</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCBUSY</name>
              <description>ENVM CRC busy flag bit</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>BUSY</name>
              <description>The eNVM is busy bit</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
        </fields>
      </register>
      <register>
        <name>ENVM_ADDR</name>
        <displayName>ENVM_ADDR</displayName>
        <description>ENVM address register</description>
        <addressOffset>0x014</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>ADDR</name>
              <description>ENVM erase command address bits</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
        </fields>
      </register>
      <register>
        <name>ENVM_CRCRESULT</name>
        <displayName>ENVM_CRCRESULT</displayName>
        <description>ENVM CRC result register</description>
        <addressOffset>0x05C</addressOffset>
        <size>0x20</size>
        <resetValue>0x00000000</resetValue>
        <fields>
            <field>
              <name>CRC_RESULT</name>
              <description>CRC calculation result, if CRCRERR is set 1, the value of CRC_RESULT[31:0] is 0x0000 0000.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ENVM_SW_REP_FATAL_ADDR</name>
          <displayName>ENVM_SW_REP_FATAL_ADDR</displayName>
          <description>ENVM software repair fatal address register</description>
          <addressOffset>0x060</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SW_REP_FATAL_ADDR</name>
              <description>The first blank address of the flash backup area or fatal address detected by software self-check. The address is in eNVM address area.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ENVM_REPCS</name>
          <displayName>ENVM_REPCS</displayName>
          <description>ENVM repair function control and status register</description>
          <addressOffset>0x0C8</addressOffset>
          <size>0x20</size>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ERR2CNT</name>
              <description>During the self-check, the number of 2 bit error occurrences without repair.</description>
              <bitOffset>27</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERR1CNT</name>
              <description>During the self-check, the number of 1 bit error occurrences without repair.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BLANKMODE</name>
              <description>Flash backup content blank mode</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ROBBCNT</name>
              <description>Bad block count bit</description>
              <bitOffset>16</bitOffset>
